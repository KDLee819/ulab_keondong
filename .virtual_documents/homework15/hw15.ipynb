import matplotlib.pyplot as plt
from matplotlib.animation import FuncAnimation

# Assuming fig and ax are defined earlier, e.g.:
fig, ax = plt.subplots()

# Set x and y limits
ax.set_xlim(-3 * AU, 3 * AU)
ax.set_ylim(-3 * AU, 3 * AU)

# Unpack the lines for orbits (make trails)
line_e, = ax.plot([], [], '-b', lw=1, label='Earth')    # Earth orbit in blue
line_m, = ax.plot([], [], '-r', lw=1, label='Mars')     # Mars orbit in red
line_c, = ax.plot([], [], '-g', lw=1, label='Comet')    # Comet orbit in green

# Unpack the points for current positions
point_e, = ax.plot([], [], 'bo', markersize=4)                 # Earth point
point_m, = ax.plot([], [], 'ro', markersize=4)                 # Mars point
point_c, = ax.plot([], [], 'go', markersize=4)                 # Comet point
point_s, = ax.plot([], [], 'o', markersize=10, color='orange') # Sun point (larger)

# Add text labels
text_e = ax.text(AU, 0, 'Earth', color='blue')
text_m = ax.text(AU, 0, 'Mars', color='red')
text_c = ax.text(AU, 0, 'Comet', color='green')
text_s = ax.text(0, 0, 'Sun', color='orange')

# Add legend
ax.legend()

# Have added initialization function because it was not working without it.
# Got some help from Grok on constructing the function
# Initialization function
def init():
    # Initialize lines with empty data
    line_e.set_data([], [])
    line_m.set_data([], [])
    line_c.set_data([], [])
    
    # Initialize points with empty data
    point_e.set_data([], [])
    point_m.set_data([], [])
    point_c.set_data([], [])
    point_s.set_data([], [])
    
    # Set initial text positions (optional, will be updated in first frame)
    text_e.set_position((xelist[0], yelist[0]) if xelist else (0, 0))
    text_m.set_position((xmlist[0], ymlist[0]) if xmlist else (0, 0))
    text_c.set_position((xclist[0], yclist[0]) if xclist else (0, 0))
    text_s.set_position((xslist[0], yslist[0]) if xslist else (0, 0))
    
    return line_e, line_m, line_c, point_e, point_m, point_c, point_s, text_e, text_m, text_c, text_s

# Update function for animation
def update(frame):
    
    # Update lines (trails)
    line_e.set_data(xelist[:frame], yelist[:frame])
    line_m.set_data(xmlist[:frame], ymlist[:frame])
    line_c.set_data(xclist[:frame], yclist[:frame])
    
    # Update points (current positions)
    point_e.set_data([xelist[frame]], [yelist[frame]])  # Wrap in list to ensure sequence
    point_m.set_data([xmlist[frame]], [ymlist[frame]])  # RuntimeError occurred previously
    point_c.set_data([xclist[frame]], [yclist[frame]])
    point_s.set_data([xslist[frame]], [yslist[frame]])
    
    # Update text positions
    text_e.set_position((xelist[frame], yelist[frame]))
    text_m.set_position((xmlist[frame], ymlist[frame]))
    text_c.set_position((xclist[frame], yclist[frame]))
    text_s.set_position((xslist[frame], yslist[frame]))
    
    return line_e, line_m, line_c, point_e, point_m, point_c, point_s, text_e, text_m, text_c, text_s
plt.show()


anim = FuncAnimation(fig, update, init_func=init, frames=len(xelist), blit=True)


anim.save("planetary_orbits.gif", writer='pillow', fps=40)





# Re-define constants
G = 6.6743e-11   # Gravitational constant, m^3 / kg s^2
Ms = 1.9884e30   # Sun mass, kg
Mmc = 0.33010e24 # Mercury mass, kg
Mvn = 4.8673e24  # Venus mass, kg
Mmn = 0.07346e24 # Moon mass, kg
Me = 5.9722e24   # Earth mass, kg
Mm = 0.33010e24  # Mars mass, kg
Mc = 6.39e20     # Comet mass, kg
AU = 149.598e9   # Astronomical Unit, m
daysec = 24 * 3600 # in s


# Re-define initial velocities (@ aphelion)
mc_ap_v = 38.86e3  # Mercury, in m/s
vn_ap_v = 34.78e3  # Venus, in m/s
mn_ap_v = 0.970e3+e_ap_v # Moon, in m/s (sum with the earth velocity)
e_ap_v = 29.29e3   # Earth, in m/s
m_ap_v = 21.97e3   # Mars, in m/s
commet_v = 7000    # Comet, in m/s


# Re-define gravitational constants
gravconst_mc = G * Mmc * Ms # Mercury
gravconst_vn = G * Mvn * Ms # Venus
gravconst_mn_s = G * Mmn * Ms ### Moon (Contribution from Sun)
gravconst_mn_e = G * Mmn * Me ### Moon (Contribution from Earth)
gravconst_e = G * Me * Ms   # Earth
gravconst_m = G * Mm * Ms   # Mars
gravconst_c = G * Mc * Ms   # Comet


# Re-define initial positions
xmc, ymc, zmc = 0.459 * AU, 0, 0  # Mercury
xvn, yvn, zvn = 0.716 * AU, 0, 0  # Venus
xmn, ymn, zmn = 1.0167 * AU + 0.3844e9, 0, 0 # Moon (Again add velocities of Earth and Moon)
xe, ye, ze = 1.0167 * AU, 0, 0    # Earth
xm, ym, zm = 1.666 * AU, 0, 0     # Mars
xc, yc, zc = 2 * AU, 0.3 * AU, 0  # Comet


# Re-define initial velocities
xvmc, yvmc, zvmc = 0, mc_ap_v, 0   # Mercury
xvvn, yvvn, zvvn = 0, vn_ap_v, 0   # Venus
xvmn, yvmn, zvmn = 0, mn_ap_v, 0   # Moon
xve, yve, zve = 0, e_ap_v, 0       # Earth
xvm, yvm, zvm = 0, m_ap_v, 0       # Mars
xvc, yvc, zvc = 0, commet_v, 0     # Comet


# Sun's position
xs, ys, zs = 0, 0, 0
# Sun's velocity
xvs, yvs, zvs = 0, 0, 0


# Initial time
t = 0
# Change in time
dt = 1 * daysec
# Years
years = 5
sim_years = years * 365 * daysec


# Re-define the empty lists
# Mercury
xmclist, ymclist = [], []

# Venus
xvnlist, yvnlist = [], []

# Moon
xmnlist, ymnlist = [], []

# Earth
xelist, yelist = [], []

# Mars
xmlist, ymlist = [], []

# Comet
xclist, yclist = [], []

# Sun
xslist, yslist = [], []


# Calculate values and append values
while t <= sim_years:

    ################ Mercury #############
    rx_mc, ry_mc, rz_mc = xmc - xs, ymc - ys, zmc - zs
    modr3_mc = (rx_mc**2 + ry_mc**2 + rz_mc**2)**1.5
    fx_mc = -gravconst_mc * rx_mc / modr3_mc
    fy_mc = -gravconst_mc * ry_mc / modr3_mc
        
    xvmc += fx_mc * dt / Mmc
    yvmc += fy_mc * dt / Mmc
    xmc += xvmc * dt
    ymc += yvmc * dt
        
    xmclist.append(xmc)
    ymclist.append(ymc)

    ################ Venus #############
    rx_vn, ry_vn, rz_vn = xvn - xs, yvn - ys, zvn - zs
    modr3_vn = (rx_vn**2 + ry_vn**2 + rz_vn**2)**1.5
    fx_vn = -gravconst_vn * rx_vn / modr3_vn
    fy_vn = -gravconst_vn * ry_vn / modr3_vn
        
    xvvn += fx_vn * dt / Mvn
    yvvn += fy_vn * dt / Mvn
    xvn += xvvn * dt
    yvn += yvvn * dt
        
    xvnlist.append(xvn)
    yvnlist.append(yvn)

    ############# Earth and Moon################
    # Earth-Sun interaction
    rx_e, ry_e = xe - xs, ye - ys
    modr3_e = (rx_e**2 + ry_e**2)**1.5
    fx_e = -gravconst_e * rx_e / modr3_e
    fy_e = -gravconst_e * ry_e / modr3_e
    
    # Moon-Earth interaction
    rx_mn, ry_mn = xmn - xe, ymn - ye
    modr3_mn = (rx_mn**2 + ry_mn**2)**1.5
    fx_me = -gravconst_mn_e * rx_mn / modr3_mn
    fy_me = -gravconst_mn_e * ry_mn / modr3_mn
    
    # Moon-Sun interaction
    rx_ms, ry_ms = xmn - xs, ymn - ys
    modr3_ms = (rx_ms**2 + ry_ms**2)**1.5
    fx_ms = -gravconst_mn_s * rx_ms / modr3_ms
    fy_ms = -gravconst_mn_s * ry_ms / modr3_ms
    
    # Update velocities
    xve += fx_e * dt / Me
    yve += fy_e * dt / Me
    xvmn += (fx_me + fx_ms) * dt / Mmn
    yvmn += (fy_me + fy_ms) * dt / Mmn
    
    # Update positions
    xe += xve * dt
    ye += yve * dt
    xmn += xvmn * dt
    ymn += yvmn * dt

    xelist.append(xe)
    yelist.append(ye)
    xmnlist.append(xmn)
    ymnlist.append(ymn)
    
    ################ Mars ##############
    rx_m, ry_m, rz_m = xm - xs, ym - ys, zm - zs
    modr3_m = (rx_m**2 + ry_m**2 + rz_m**2)**1.5
    fx_m = -gravconst_m * rx_m / modr3_m
    fy_m = -gravconst_m * ry_m / modr3_m
        
    xvm += fx_m * dt / Mm
    yvm += fy_m * dt / Mm
    xm += xvm * dt
    ym += yvm * dt
        
    xmlist.append(xm)
    ymlist.append(ym)
    
    ################ Comet ##############
    rx_c, ry_c, rz_c = xc - xs, yc - ys, zc - zs
    modr3_c = (rx_c**2 + ry_c**2 + rz_c**2)**1.5
    fx_c = -gravconst_c * rx_c / modr3_c
    fy_c = -gravconst_c * ry_c / modr3_c
        
    xvc += fx_c * dt / Mc
    yvc += fy_c * dt / Mc
    xc += xvc * dt
    yc += yvc * dt
        
    xclist.append(xc)
    yclist.append(yc)
    
    ################ Sun ##############
    xvs += -(fx_e + fx_m + fx_c) * dt / Ms ## I added contribution from a comet as well
    yvs += -(fy_e + fy_m + fy_c) * dt / Ms ## (even though its effect would be negligible)
    xs += xvs * dt
    ys += yvs * dt
    xslist.append(xs)
    yslist.append(ys)

    t += dt


