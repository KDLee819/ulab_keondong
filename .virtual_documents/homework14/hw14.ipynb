# Campbell Hall: 37.873199°N 122.257063°W
# From Wikipedia, the free encyclopedia
lat = 37.873199 * u.deg
lon = -122.257063 * u.deg
height = 25 * u.meter # Assume top of the building ~ 25m

# Define the position as instructed
